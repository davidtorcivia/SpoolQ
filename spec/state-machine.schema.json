{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SteadQ/1 State Machine",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transitions",
    "exceptions",
    "reentry"
  ],
  "properties": {
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "source",
          "destination",
          "generation_change",
          "attempt_change",
          "token_change",
          "reason_class",
          "required_syncs",
          "no_overwrite",
          "resolution_behavior",
          "notes"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "enqueue_immediate",
              "enqueue_delayed",
              "promote",
              "claim",
              "exhausted_ready_cleanup",
              "renew",
              "acknowledge",
              "retry_now",
              "retry_later",
              "bury",
              "reap_expired_to_ready",
              "reap_expired_to_dead",
              "quarantine"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "hidden",
              "ready",
              "leased",
              "delayed",
              "dead",
              "receipt",
              "quarantine",
              "active"
            ]
          },
          "destination": {
            "type": "string",
            "enum": [
              "ready",
              "leased",
              "delayed",
              "dead",
              "receipt",
              "quarantine"
            ]
          },
          "generation_change": {
            "type": "string",
            "enum": [
              "zero",
              "increment",
              "increment_or_same"
            ]
          },
          "attempt_change": {
            "type": "string",
            "enum": [
              "zero",
              "increment",
              "unchanged"
            ]
          },
          "token_change": {
            "type": "string",
            "enum": [
              "none",
              "new",
              "same"
            ]
          },
          "reason_class": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "enum": [
                  "attempts_exhausted",
                  "application_defined",
                  "corruption"
                ]
              }
            ]
          },
          "required_syncs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "file_fsync",
                "destination_dir_fsync",
                "source_dir_fsync",
                "same_or_destination_dir_fsync"
              ]
            }
          },
          "no_overwrite": {
            "const": true
          },
          "resolution_behavior": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "uses_replacing_rename"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "receipt_compaction",
              "wall_watermark_advancement"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "uses_replacing_rename": {
            "const": true
          }
        }
      }
    },
    "reentry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "description",
          "creates_new_identity"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "requeue_dead",
              "requeue_quarantine"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "dead",
              "quarantine"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "creates_new_identity": {
            "const": true
          }
        }
      }
    }
  }
}
