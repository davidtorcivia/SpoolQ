{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SteadQ/1 State Machine",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "transitions",
    "exceptions",
    "unlinks",
    "reentry"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "steadq-state-machine"
    },
    "version": {
      "type": "integer",
      "minimum": 3,
      "const": 3
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "source",
          "source_object_kind",
          "destination",
          "destination_object_kind",
          "generation_change",
          "attempt_change",
          "token_change",
          "reason_class",
          "clock_requirement",
          "required_syncs",
          "linearization",
          "before_linearization_failure",
          "after_linearization_failure",
          "resolver_probe_topology",
          "qualification"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "enqueue_immediate",
              "enqueue_delayed",
              "promote",
              "claim",
              "exhausted_ready_cleanup",
              "renew",
              "acknowledge",
              "retry_now",
              "retry_later",
              "bury",
              "reap_expired_to_ready",
              "reap_expired_to_dead",
              "quarantine"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "hidden",
              "ready",
              "leased",
              "delayed",
              "dead",
              "receipt",
              "quarantine",
              "active"
            ]
          },
          "source_object_kind": {
            "type": "string",
            "enum": [
              "full_job",
              "full_receipt",
              "compact_receipt",
              "raw_object",
              "watermark_record"
            ]
          },
          "destination": {
            "type": "string",
            "enum": [
              "ready",
              "leased",
              "delayed",
              "dead",
              "receipt",
              "quarantine"
            ]
          },
          "destination_object_kind": {
            "type": "string",
            "enum": [
              "full_job",
              "full_receipt",
              "compact_receipt",
              "raw_object",
              "watermark_record"
            ]
          },
          "generation_change": {
            "type": "string",
            "enum": [
              "zero",
              "increment",
              "increment_or_same"
            ]
          },
          "attempt_change": {
            "type": "string",
            "enum": [
              "zero",
              "increment",
              "unchanged"
            ]
          },
          "token_change": {
            "type": "string",
            "enum": [
              "none",
              "new",
              "same"
            ]
          },
          "reason_class": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "enum": [
                  "attempts_exhausted",
                  "application_defined",
                  "corruption"
                ]
              }
            ]
          },
          "clock_requirement": {
            "type": "string",
            "enum": [
              "none",
              "authenticated_wall_floor",
              "boottime_and_authenticated_wall_floor",
              "lease_expiration_evidence",
              "lease_expiration_evidence_and_authenticated_wall_floor"
            ]
          },
          "required_syncs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "file_fsync",
                "destination_dir_fsync",
                "source_dir_fsync",
                "same_or_destination_dir_fsync",
                "source_dir_fsync_if_distinct"
              ]
            }
          },
          "linearization": {
            "type": "string",
            "enum": [
              "publish_noreplace",
              "rename_noreplace"
            ]
          },
          "before_linearization_failure": {
            "const": "not_committed"
          },
          "after_linearization_failure": {
            "const": "outcome_unknown"
          },
          "resolver_probe_topology": {
            "type": "string",
            "enum": [
              "destination_only",
              "source_and_destination",
              "receipt_candidates_and_source"
            ]
          },
          "qualification": {
            "type": "string",
            "enum": [
              "none",
              "attempts_remaining",
              "attempts_exhausted",
              "raw_bytes_preserved"
            ]
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "source_object_kind",
          "destination_object_kind",
          "clock_requirement",
          "mutation_class",
          "linearization",
          "required_syncs",
          "before_linearization_failure",
          "after_linearization_failure"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "receipt_compaction",
              "wall_watermark_advancement"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_object_kind": {
            "type": "string",
            "enum": [
              "full_job",
              "full_receipt",
              "compact_receipt",
              "raw_object",
              "watermark_record"
            ]
          },
          "destination_object_kind": {
            "type": "string",
            "enum": [
              "full_job",
              "full_receipt",
              "compact_receipt",
              "raw_object",
              "watermark_record"
            ]
          },
          "clock_requirement": {
            "type": "string",
            "enum": [
              "none",
              "authenticated_wall_floor",
              "boottime_and_authenticated_wall_floor",
              "lease_expiration_evidence",
              "lease_expiration_evidence_and_authenticated_wall_floor"
            ]
          },
          "mutation_class": {
            "type": "string",
            "enum": [
              "no_overwrite_move",
              "replacing_move",
              "publication",
              "unlink",
              "in_place_read_only_barrier"
            ]
          },
          "linearization": {
            "const": "rename_replace"
          },
          "required_syncs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "file_fsync",
                "destination_dir_fsync",
                "source_dir_fsync",
                "same_or_destination_dir_fsync",
                "source_dir_fsync_if_distinct"
              ]
            }
          },
          "before_linearization_failure": {
            "const": "not_committed"
          },
          "after_linearization_failure": {
            "const": "outcome_unknown"
          }
        }
      }
    },
    "unlinks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "source",
          "source_object_kind",
          "source_authentication",
          "clock_requirement",
          "qualification",
          "mutation_class",
          "linearization",
          "required_syncs",
          "before_linearization_failure",
          "after_linearization_failure",
          "resolver_probe_topology"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "full_receipt_retention_deletion",
              "compact_receipt_retention_deletion"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "const": "receipt"
          },
          "source_object_kind": {
            "type": "string",
            "enum": [
              "full_job",
              "full_receipt",
              "compact_receipt",
              "raw_object",
              "watermark_record"
            ]
          },
          "source_authentication": {
            "const": "strict_receipt"
          },
          "clock_requirement": {
            "type": "string",
            "enum": [
              "none",
              "authenticated_wall_floor",
              "boottime_and_authenticated_wall_floor",
              "lease_expiration_evidence",
              "lease_expiration_evidence_and_authenticated_wall_floor"
            ]
          },
          "qualification": {
            "const": "receipt_bucket_end_plus_retention_not_after_wall_floor"
          },
          "mutation_class": {
            "const": "unlink"
          },
          "linearization": {
            "const": "unlink"
          },
          "required_syncs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "file_fsync",
                "destination_dir_fsync",
                "source_dir_fsync",
                "same_or_destination_dir_fsync",
                "source_dir_fsync_if_distinct"
              ]
            }
          },
          "before_linearization_failure": {
            "const": "not_committed"
          },
          "after_linearization_failure": {
            "const": "outcome_unknown"
          },
          "resolver_probe_topology": {
            "const": "source_presence"
          }
        }
      }
    },
    "reentry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "description",
          "creates_new_identity"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "requeue_dead",
              "requeue_quarantine"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "dead",
              "quarantine"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "creates_new_identity": {
            "const": true
          }
        }
      }
    }
  }
}
